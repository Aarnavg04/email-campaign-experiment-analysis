# Data — downloaded at build time, never committed
data/

# Secrets
.env

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Intermediate/scratch figures. Final figures ARE committed so the README
# renders on GitHub — only throwaway plots are ignored.
figures/scratch/

# Internal build plan. Kept local: it contains resume-bullet drafts and
