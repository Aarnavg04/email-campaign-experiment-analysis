# Copy to .env and adjust if needed. The defaults match docker-compose.yml
# and work as-is.

POSTGRES_DB=hillstrom
POSTGRES_USER=hillstrom
POSTGRES_PASSWORD=hillstrom
POSTGRES_HOST=localhost

# 5433, not 5432 -- see the comment in docker-compose.yml. Pointing this at
# 5432 may connect to an unrelated PostgreSQL server on the host.
POSTGRES_PORT=5433
